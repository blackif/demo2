{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "readme.schema.json",
  "title": "readme.json",
  "description": "程序包式样书(readme.md)的生成控制与内容数据。由 AI 生成，人类只读，人类只编辑 md。规则：1) fields[].status=confirmed 表示该项由 AI 负责，content 中对应的键必须非 null，重新生成时覆盖 md 对应章节；2) status=unknown 表示需要人类补充，content 中对应的键必须为 null，md 输出「要確認」标记，重新生成时若 md 已有人工内容则保留；3) confirmed 且内容为空数组，表示 AI 已判断且代码中不存在，md 输出「-」。fields 与 content 的对应关系见 content 各属性的 x-field。",
  "type": "object",
  "required": ["schemaVersion", "meta", "files", "fields", "content"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "schema 版本号。模板结构或字段变化时升级。"
    },
    "meta": {
      "type": "object",
      "required": ["package", "packagePath", "template", "language"],
      "additionalProperties": false,
      "properties": {
        "package": { "type": "string", "minLength": 1, "description": "程序包名" },
        "packagePath": { "type": "string", "minLength": 1, "description": "程序包相对仓库根的路径" },
        "template": { "type": "string", "minLength": 1, "description": "所用模板的相对路径" },
        "language": { "enum": ["ja", "zh", "en"], "description": "md 的输出语言，默认 ja" }
      }
    },
    "files": {
      "type": "array",
      "description": "文件对象清单。程序包内（document 目录除外）的每个文件都必须登记。",
      "items": {
        "type": "object",
        "required": ["path", "objectName", "objectType", "status", "role"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "相对程序包根目录的路径" },
          "objectName": { "type": ["string", "null"], "description": "SAP 对象名。无法确定时为 null" },
          "objectType": {
            "enum": [
              "class", "function_module", "include", "report", "append_structure", "structure",
              "table", "data_element", "domain", "cds_view", "behavior_definition",
              "enhancement", "message_class", "other", "unclassified"
            ],
            "description": "按文件内容判断的对象类型，不依赖目录名。无法判断为 unclassified"
          },
          "status": { "$ref": "#/$defs/status", "description": "confirmed=已判断类型并已分析内容；unknown=无法判断或无法分析，需要人工确认" },
          "role": { "type": ["string", "null"], "description": "该文件在本程序包中的作用（一句话）。unknown 时为 null" }
        }
      }
    },
    "fields": {
      "type": "array",
      "description": "控制清单。模板中自带内容的每个标题对应一项，md 的各章节据此判断输出文字还是「要確認」。",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["field", "status"],
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "## 業務要件",
              "## 機能要件",
              "## 業務フロー",
              "## 処理概要",
              "### 1. 機能概要",
              "### 2. 処理詳細",
              "### 3. 処理条件",
              "### 4. 処理概要図",
              "### **前提条件：**",
              "### **制約条件：**",
              "## 依存関係",
              "### 使用公開API",
              "### **メッセージ**",
              "### データモデル・項目情報",
              "### 例外処理",
              "# テスト仕様書"
            ],
            "description": "模板中的标题原文（含 # 和加粗符号）"
          },
          "status": { "$ref": "#/$defs/status" },
          "reason": { "type": "string", "minLength": 1, "description": "unknown 的原因（给人看，不写入 md）" }
        },
        "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
        "then": { "required": ["reason"] }
      }
    },
    "content": {
      "type": "object",
      "description": "各项目的内容清单。键为英文名，对应的标题见 x-field。值为 null 表示 unknown；空数组表示「已判断，代码中不存在」。表格类的行号（No.）由渲染脚本自动编号。",
      "additionalProperties": false,
      "required": [
        "businessRequirement", "functionalRequirement", "businessFlow", "processSummary",
        "functionOverview", "processSteps", "processConditions", "flowchart",
        "prerequisites", "constraints", "dependencies", "publicApis",
        "messages", "dataModel", "exceptionHandling", "testCases"
      ],
      "properties": {
        "businessRequirement": {
          "x-field": "## 業務要件",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/paragraphs" }]
        },
        "functionalRequirement": {
          "x-field": "## 機能要件",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/paragraphs" }]
        },
        "businessFlow": {
          "x-field": "## 業務フロー",
          "description": "Mermaid sequenceDiagram，逐行存放",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/mermaid" }]
        },
        "processSummary": {
          "x-field": "## 処理概要",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/paragraphs" }]
        },
        "functionOverview": {
          "x-field": "### 1. 機能概要",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["functionName", "processingMethod", "processingSummary"],
              "additionalProperties": false,
              "properties": {
                "functionName": { "type": "string", "minLength": 1 },
                "processingMethod": { "type": "string", "minLength": 1 },
                "processingSummary": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "processSteps": {
          "x-field": "### 2. 処理詳細",
          "description": "按源码处理顺序排列",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "details"],
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "details": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                }
              }
            }
          ]
        },
        "processConditions": {
          "x-field": "### 3. 処理条件",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["target", "condition", "onTrue", "onFalse"],
                "additionalProperties": false,
                "properties": {
                  "target": { "type": "string", "minLength": 1 },
                  "condition": { "type": "string", "minLength": 1 },
                  "onTrue": { "type": "string", "minLength": 1 },
                  "onFalse": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "flowchart": {
          "x-field": "### 4. 処理概要図",
          "description": "Mermaid flowchart，逐行存放",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/mermaid" }]
        },
        "prerequisites": {
          "x-field": "### **前提条件：**",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/paragraphs" }]
        },
        "constraints": {
          "x-field": "### **制約条件：**",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/paragraphs" }]
        },
        "dependencies": {
          "x-field": "## 依存関係",
          "description": "表、视图、CDS 视图以外的依赖对象（包内对象、标准类、DDIC 结构、追加结构、异常类等）。类型和数据元素不列。",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["objectName", "objectType", "purpose"],
                "additionalProperties": false,
                "properties": {
                  "objectName": { "type": "string", "minLength": 1 },
                  "objectType": { "type": "string", "minLength": 1 },
                  "purpose": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "publicApis": {
          "x-field": "### 使用公開API",
          "description": "程序用到的表、CDS 视图等（自制、标准均算），不与 dependencies 重复。",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["apiName", "apiType", "purpose"],
                "additionalProperties": false,
                "properties": {
                  "apiName": { "type": "string", "minLength": 1 },
                  "apiType": { "type": "string", "minLength": 1 },
                  "purpose": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "messages": {
          "x-field": "### **メッセージ**",
          "description": "代码中确认到的消息。空数组表示代码中没有消息输出，md 的表格各列输出「-」。",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["errorCase", "message", "arguments", "note", "messageClass"],
                "additionalProperties": false,
                "properties": {
                  "errorCase": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 },
                  "arguments": { "type": "string", "minLength": 1 },
                  "note": { "type": "string", "minLength": 1 },
                  "messageClass": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "dataModel": {
          "x-field": "### データモデル・項目情報",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["objectName", "fieldName", "purpose", "processing"],
                "additionalProperties": false,
                "properties": {
                  "objectName": { "type": "string", "minLength": 1 },
                  "fieldName": { "type": "string", "minLength": 1 },
                  "purpose": { "type": "string", "minLength": 1 },
                  "processing": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "exceptionHandling": {
          "x-field": "### 例外処理",
          "description": "label 使用模板中的固定标签：データ取得結果が0件の場合 / 設定情報が取得できない場合 / 対象条件を満たさない場合 / 例外発生時 / その他",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "text"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "testCases": {
          "x-field": "# テスト仕様書",
          "description": "只写条件，不写具体数值",
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["majorNo", "minorNo", "majorCase", "minorCase", "expected"],
                "additionalProperties": false,
                "properties": {
                  "majorNo": { "type": "string", "minLength": 1 },
                  "minorNo": { "type": "string", "minLength": 1 },
                  "majorCase": { "type": "string", "minLength": 1 },
                  "minorCase": { "type": "string", "minLength": 1 },
                  "expected": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["confirmed", "unknown"],
      "description": "confirmed=AI 负责（md 重新生成时覆盖）；unknown=人类补充（md 重新生成时保留已有人工内容）"
    },
    "paragraphs": {
      "type": "array",
      "description": "文字段落或要点，每个元素一段（一条）",
      "items": { "type": "string", "minLength": 1 }
    },
    "mermaid": {
      "type": "object",
      "required": ["mermaid"],
      "additionalProperties": false,
      "properties": {
        "mermaid": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      }
    }
  }
}
